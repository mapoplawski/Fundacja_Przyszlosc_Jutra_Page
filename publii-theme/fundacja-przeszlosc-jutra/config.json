{
  "name": "Fundacja Przeszłość Jutra",
  "version": "2.0.0",
  "author": "Fundacja Przeszłość Jutra",
  "renderer": {
    "createContentStructure": true,
    "createSearchPage": false,
    "create404Page": true
  },
  "supportedFeatures": {
    "authorImages": true,
    "blockEditor": true,
    "customElements": true,
    "pages": true,
    "tagsList": true,
    "responsiveImages": true
  },
  "files": {
    "assetsPath": "assets",
    "responsiveImages": {
      "contentImages": {
        "dimensions": {
          "xs": {
            "width": 480,
            "height": "auto"
          },
          "md": {
            "width": 960,
            "height": "auto"
          },
          "xl": {
            "width": 1600,
            "height": "auto"
          }
        }
      },
      "featuredImages": {
        "dimensions": {
          "xs": {
            "width": 480,
            "height": 320,
            "crop": true
          },
          "md": {
            "width": 960,
            "height": 640,
            "crop": true
          },
          "xl": {
            "width": 1600,
            "height": 900,
            "crop": true
          }
        }
      }
    }
  },
  "menus": {
    "mainMenu": "Menu główne",
    "footerMenu": "Menu w stopce"
  },
  "config": {
    "postsPerPage": 9,
    "tagsPostsPerPage": 9,
    "authorsPostsPerPage": 9,
    "excerptLength": 32,
    "logo": ""
  },
  "customConfig": [
